{
  "name": "nestjs-angular-user-feature-upgrade",
  "version": "1.0.0",
  "description": "Full-Stack NestJS + Angular Enterprise Platform",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run start:backend\" \"npm run start:frontend\"",
    "dev:backend": "npm run start:backend",
    "dev:frontend": "npm run start:frontend",
    "start": "npm run dev",
    "start:backend": "npm --prefix backend run start:dev",
    "start:frontend": "npm --prefix frontend start",
    "build": "npm --prefix frontend run build",
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "seed": "npm --prefix backend run seed",
    "test:backend": "npm --prefix backend test",
    "test:e2e": "npm --prefix backend run test:e2e"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
